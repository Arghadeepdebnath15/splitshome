# Set this to your Render backend URL in Vercel's Environment Variables
# Example: https://flatmate-api.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# Set this to your Render backend URL (without /api) for Socket.IO
# Example: https://flatmate-api.onrender.com
VITE_SOCKET_URL=http://localhost:5001

